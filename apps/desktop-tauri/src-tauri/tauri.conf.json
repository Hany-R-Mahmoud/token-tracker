{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Token Tracker",
  "version": "0.1.0",
  "identifier": "com.token-tracker.app",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "cd ../.. && npm run build && node apps/desktop/dist/index.js",
    "beforeBuildCommand": "cd ../.. && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Token Tracker",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
