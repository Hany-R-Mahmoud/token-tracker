# Token Tracker Team Web - Environment Variables
# Copy this file to .env and fill in the values

# Server configuration
TTM_WEB_PORT=3200
# Optional public origin used to build GitHub OAuth redirect URIs
# Example: http://localhost:3200 or https://token-tracker.example.com
TTM_WEB_ORIGIN=

# GitHub OAuth (required for production)
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Team configuration
TTM_DEFAULT_TEAM_ID=default-team
TTM_DEFAULT_TEAM_NAME=Default Team

# Database (optional, defaults to .ttm/leaderboard.sqlite)
TTM_LEADERBOARD_DB_PATH=

# Admin API key (optional but recommended for production)
# Protects POST /api/compute-snapshot endpoint
TTM_ADMIN_API_KEY=your_secret_admin_key
